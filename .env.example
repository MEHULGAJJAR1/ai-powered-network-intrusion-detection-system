# Flask/NIDS runtime configuration. Copy to .env and change all production values.
NIDS_ENV=development
NIDS_SECRET_KEY=replace-with-a-long-random-secret
NIDS_DATA_PATH=data/raw/kddcup.data_10_percent.gz
NIDS_ARTIFACT_DIR=artifacts
NIDS_HISTORY_DB=data/nids_history.sqlite3
NIDS_MAX_UPLOAD_MB=10
NIDS_MAX_BATCH_ROWS=5000
NIDS_MAX_JSON_BATCH_ROWS=500
NIDS_MAX_HISTORY_ROWS=50000
NIDS_EXPLORATION_MAX_ROWS=100000
NIDS_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
NIDS_RATE_LIMIT_DEFAULT=300 per hour
# Use Redis for a multi-worker/production deployment, e.g. redis://redis:6379/0
NIDS_RATE_LIMIT_STORAGE_URI=memory://
NIDS_LOG_LEVEL=INFO
PORT=5000
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
# Compose bind-mount ownership on Linux (set these to your host uid/gid if needed).
NIDS_UID=1000
NIDS_GID=1000
